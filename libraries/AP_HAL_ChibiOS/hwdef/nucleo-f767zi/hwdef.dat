# hw definition file for Nucleo-F767ZI (STANDARDIZED FROM MATEK F765)

MCU STM32F7xx STM32F767xx
FLASH_SIZE_KB 2048

# Nạp trực tiếp qua ST-LINK từ địa chỉ 0x08000000
FLASH_RESERVE_START_KB 0
APJ_BOARD_ID 1767

OSCILLATOR_HZ 8000000
define HAL_EXPECTED_SYSCLK 216000000
define STM32_HSE_BYPASS TRUE
define AP_BOOTLOADER_FLASHING_ENABLED 0

STM32_ST_USE_TIMER 12
define CH_CFG_ST_RESOLUTION 16

# ====================================================
# SERIAL & MAVLINK (USART3 ST-LINK)
# ====================================================
SERIAL_ORDER USART3 OTG1

STDOUT_SERIAL SD3
STDOUT_BAUDRATE 115200

PD8 USART3_TX USART3 SPEED_HIGH
PD9 USART3_RX USART3 SPEED_HIGH

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# ====================================================
# SPI4 - IMU ICM-42688 (CẤU HÌNH THEO CHUẨN MATEK)
# ====================================================
PE4 ICM_CS CS
PE2 SPI4_SCK  SPI4
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4

# Tốc độ boot 1MHz (chuẩn Matek) -> Tốc độ chạy 8MHz
SPIDEV icm42688 SPI4 DEVID1 ICM_CS MODE3 1*MHZ 8*MHZ
IMU Invensensev3 SPI:icm42688 ROTATION_NONE

# ====================================================
# I2C1 - BARO BMP388 & COMPASS BMM150
# ====================================================
I2C_ORDER I2C1

PB8 I2C1_SCL I2C1 PULLUP
PB9 I2C1_SDA I2C1 PULLUP

define HAL_I2C_BUS0_SPEED 100000
define HAL_I2C_CLEAR_BUS 1

# Cảm biến áp suất khí quyển
BARO BMP388 I2C:0:0x76

# ====================================================
# COMPASS BMM150 (GÁN TRỰC TIẾP TRÊN I2C1 - BUS LOGIC 0)
# ====================================================
# 0x13 là địa chỉ 7-bit (tương đương 0x26 ở dạng 8-bit khi chân SDO/ADDR nối VDD/3.3V)
# Nếu chân SDO/ADDR nối GND, hãy đổi 0x13 thành 0x10
COMPASS BMM150 I2C:0:0x13 true ROTATION_NONE

# Bật Driver BMM150 và tắt Driver HMC
define AP_COMPASS_BMM150_ENABLED 1


# Tự động phân bổ DMA & Hệ thống
DMA_PRIORITY S*
define HAL_USE_ADC FALSE
define AP_WATCHDOG_ENABLED 0

# ====================================================
# PWM ĐỘNG CƠ (4 Kênh - TIM1)
# ====================================================
PE9  TIM1_CH1 TIM1 PWM(1) GPIO(50)
PE11 TIM1_CH2 TIM1 PWM(2) GPIO(51)
PE13 TIM1_CH3 TIM1 PWM(3) GPIO(52)
PE14 TIM1_CH4 TIM1 PWM(4) GPIO(53)

# ====================================================
# BỘ NHỚ LƯU PARAMETER & SWD
# ====================================================
PB0 LED0 OUTPUT LOW GPIO(90)
define HAL_GPIO_A_LED_PIN 90

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

define SERIAL_BUFFERS_SIZE 4096
define DMA_RESERVE_SIZE 8192

STORAGE_FLASH_PAGE 10
define HAL_STORAGE_SIZE 16384